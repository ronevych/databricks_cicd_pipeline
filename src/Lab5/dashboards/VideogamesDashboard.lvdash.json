{
  "datasets": [
    {
      "name": "43a0cab2",
      "displayName": "top_10_global_publishers",
      "queryLines": [
        "SELECT \r\n",
        "  publisher, \r\n",
        "  total_global_sales \r\n",
        "FROM ${var.catalog}.${var.schema}.gold_publisher_performance \r\n",
        "ORDER BY total_global_sales DESC \r\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "a536b03d",
      "displayName": "sales_trends_year_genre",
      "queryLines": [
        "SELECT \r\n",
        "  release_year, \r\n",
        "  genre, \r\n",
        "  yearly_global_sales \r\n",
        "FROM ${var.catalog}.${var.schema}.gold_genre_trends\r\n",
        "WHERE release_year > 2000 \r\n",
        "ORDER BY release_year ASC"
      ]
    }
  ],
